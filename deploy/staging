#!/usr/bin/env bash
set -euo pipefail

deploy_dir=$(cd -- "$(dirname -- "$0")" && pwd)
action=$(basename -- "$0")
state="$deploy_dir/.staging"
config=${CURRICULA_STAGING_CONFIG:-"$deploy_dir/.env.staging"}
rdf_root=/var/lib/curricula/rdf
export API_REVISION=${API_REVISION:-d4f2ec98a600f9ca99f277257ef03ae8f4d7f76c}
export WEB_REVISION=${WEB_REVISION:-95f920fd334b2d223214de73c83064458f520b99}
export RDF_COMMIT=${RDF_COMMIT:-17c4c1db6901381b41bd377fb8c24c2f868c1f23}
export RDF_MANIFEST_SHA256=${RDF_MANIFEST_SHA256:-25152ce02ee0b6b0cf6039b74d9d5d41cb058571cb05097845d86eb88bbaf8ba}
export RDF_PACKAGE_DIR=${RDF_PACKAGE_DIR:-"$state/releases/$RDF_MANIFEST_SHA256"}
export CURRICULA_RDF_PRODUCERS CURRICULA_RDF_EDUCATION_PRODUCERS

fail() { printf '%s\n' "$*" >&2; exit 1; }

settings() {
    [[ $project =~ ^[a-z0-9][a-z0-9_-]*$ ]] || fail "Use a lowercase Compose project name"
    [[ $WEB_BIND_PORT =~ ^[1-9][0-9]{0,4}$ ]] && (( WEB_BIND_PORT <= 65535 )) || fail "Invalid loopback web port"
    case "$STAGING_PLATFORM" in
        linux/amd64|linux/arm64) ;;
        *) fail "Choose linux/amd64 or linux/arm64" ;;
    esac
}

if [[ $action == configure ]]; then
    (( $# <= 3 )) || fail "Usage: deploy/configure [project] [web-port] [platform]"
    case "$(uname -m)" in
        x86_64) native=linux/amd64 ;;
        aarch64|arm64) native=linux/arm64 ;;
        *) native=unsupported ;;
    esac
    project=${1:-curricula-staging}
    WEB_BIND_PORT=${2:-8080}
    STAGING_PLATFORM=${3:-$native}
    settings
    (umask 077; set -o noclobber
        printf 'project=%s\nWEB_BIND_PORT=%s\nSTAGING_PLATFORM=%s\n' \
            "$project" "$WEB_BIND_PORT" "$STAGING_PLATFORM" > "$config"
    )
    printf 'Configured %s in %s\n' "$project" "$config"
    exit 0
fi

[[ -f $config ]] || fail "Run deploy/configure first"
unset project WEB_BIND_PORT STAGING_PLATFORM
while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^(project|WEB_BIND_PORT|STAGING_PLATFORM)=([a-z0-9_/-]+)$ ]] || fail "Invalid staging configuration"
    key=${BASH_REMATCH[1]}
    [[ ! -v $key ]] || fail "Duplicate staging configuration key"
    printf -v "$key" '%s' "${BASH_REMATCH[2]}"
done < "$config"
[[ -v project && -v WEB_BIND_PORT && -v STAGING_PLATFORM ]] || fail "Incomplete staging configuration"
settings
for revision in "$API_REVISION" "$WEB_REVISION" "$RDF_COMMIT"; do
    [[ $revision =~ ^[0-9a-f]{40}$ ]] || fail "Expected immutable Git commit pins"
done
[[ $RDF_MANIFEST_SHA256 =~ ^[0-9a-f]{64}$ && $RDF_PACKAGE_DIR == /* ]] ||
    fail "Expected a manifest SHA-256 and absolute package directory"
export WEB_BIND_PORT STAGING_PLATFORM
if [[ $action != check ]]; then
    mkdir -p "$state"
    exec 9>"$state/$project.lock"
    flock -n 9 || fail "Another deployment command is running for $project"
fi

base=(docker compose -p "$project" -f "$deploy_dir/compose.yaml")
stack=("${base[@]}" -f "$deploy_dir/compose.persisted.yaml")

build_images() {
    local service revision
    for service in api web; do
        case $service in api) revision=$API_REVISION ;; web) revision=$WEB_REVISION ;; esac
        if [[ $(docker image inspect --format '{{.Os}}/{{.Architecture}} {{index .Config.Labels "org.opencontainers.image.revision"}}' \
                "curricula-staging-$service:$revision" 2>/dev/null || true) != "$STAGING_PLATFORM $revision" ]]; then
            bash "$deploy_dir/package.sh"
            "${stack[@]}" build
            break
        fi
    done
}

selection() {
    "${stack[@]}" run --rm --no-deps -T --entrypoint bash api -ec '
        root=$1
        if [[ -e $root/release-state ]]; then
            head -n 1 "$root/release-state"
        elif [[ -e $root/active.txt ]]; then
            head -n 1 "$root/active.txt"
        else
            printf "empty\n"
        fi
    ' selection "$rdf_root"
}

fetch_fixture() (
    set -euo pipefail
    if [[ ! -d $RDF_PACKAGE_DIR ]]; then
        local_parent=$(dirname -- "$RDF_PACKAGE_DIR")
        mkdir -p "$local_parent"
        scratch=$(mktemp -d "$local_parent/.incoming.XXXXXX")
        trap 'rm -rf -- "$scratch"' EXIT
        curl --fail --silent --show-error --location --retry 3 --connect-timeout 20 \
            --proto '=https' --proto-redir '=https' \
            "https://codeload.github.com/curricula-live/ontology-formal-sciences/tar.gz/$RDF_COMMIT" \
            -o "$scratch/archive.tar.gz"
        install -d -m 0755 "$scratch/package"
        tar -xzf "$scratch/archive.tar.gz" --directory "$scratch/package" --strip-components=2 \
            "ontology-formal-sciences-$RDF_COMMIT/dist"
        chmod 0644 "$scratch/package/"*
        printf '%s  %s\n' "$RDF_MANIFEST_SHA256" "$scratch/package/manifest.json" | sha256sum --check
        mv -T -- "$scratch/package" "$RDF_PACKAGE_DIR"
    fi
    printf '%s  %s\n' "$RDF_MANIFEST_SHA256" "$RDF_PACKAGE_DIR/manifest.json" | sha256sum --check
)

start() { "${stack[@]}" up --no-build -d --wait --wait-timeout 240; }

check() {
    local publication api web_search concept origin
    publication=$("${stack[@]}" exec -T api curricula-healthcheck 8081 /api/v1/knowledge/publication '"available":true')
    jq -ce --arg digest "$RDF_MANIFEST_SHA256" --arg commit "$RDF_COMMIT" \
        'select(.available and .manifestSha256 == $digest and .sourceCommit == $commit and .concepts > 0)
        | {version, concepts, manifestSha256, sourceCommit}' <<<"$publication"
    api=$("${stack[@]}" ps -q api)
    docker inspect --format '{{json .HostConfig.PortBindings}}' "$api" | jq -e '(. // {} | length) == 0' >/dev/null
    [[ $("${stack[@]}" port web 8080) == "127.0.0.1:$WEB_BIND_PORT" ]]
    origin="http://127.0.0.1:$WEB_BIND_PORT"
    curl --noproxy '*' -fsS --max-time 15 "$origin/actuator/health" | jq -e '.status == "UP"' >/dev/null
    web_search=$(curl --noproxy '*' -fsS --max-time 15 "$origin/search/results?q=DPLL&category=concepts")
    grep -Fq 'href="/concepts/dpll-algorithm"' <<<"$web_search"
    concept=$(curl --noproxy '*' -fsS --max-time 15 "$origin/concepts/dpll-algorithm")
    grep -Fq 'https://curricula.live/id/formal-sciences/concept/dpll-algorithm' <<<"$concept"
    printf 'Web health, DPLL search and concept page passed. API has no published port.\n'
}

backup() (
    local_file=$1
    [[ ! -e $local_file && ! -e $local_file.sha256 ]] || fail "Backup destination already exists"
    docker volume inspect "${project}_rdf-data" >/dev/null || fail "Start this project before backing it up"
    umask 077
    staging=$(mktemp --tmpdir="$(dirname -- "$local_file")" -d .rdf-backup.XXXXXX)
    running_services=$("${stack[@]}" ps --services --status running api web)
    running=()
    if [[ -n $running_services ]]; then mapfile -t running <<< "$running_services"; fi
    finish() {
        status=$?
        rm -rf -- "$staging"
        if (( ${#running[@]} )); then "${stack[@]}" start "${running[@]}" || status=1; fi
        exit "$status"
    }
    trap finish EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    "${stack[@]}" stop web api >/dev/null
    [[ $(selection) == "$RDF_MANIFEST_SHA256" ]] || fail "The volume does not contain the expected active release"
    "${stack[@]}" run --rm --no-deps -T --entrypoint tar api \
        --sparse -cpf - -C "$rdf_root" . > "$staging/backup.tar"
    tar -tf "$staging/backup.tar" >/dev/null
    digest=$(sha256sum "$staging/backup.tar" | cut -d ' ' -f 1)
    printf '%s\n' "$digest" > "$staging/sha256"
    ln -- "$staging/backup.tar" "$local_file"
    if ! ln -- "$staging/sha256" "$local_file.sha256"; then
        rm -- "$local_file"
        fail "Cannot publish the backup checksum"
    fi
    printf 'Backup written to %s\n' "$local_file"
)

case "$action" in
    up)
        (( $# == 0 )) || fail "Usage: deploy/up"
        build_images
        case "$(selection)" in
            empty)
                fetch_fixture
                "${base[@]}" run --rm --no-deps -T api rdf-import formal-sciences \
                    /releases/formal-sciences "$RDF_MANIFEST_SHA256" "$RDF_COMMIT"
                ;;
            "$RDF_MANIFEST_SHA256") ;;
            *) fail "The active fixture differs from this profile. Use a fresh staging project." ;;
        esac
        start
        check
        ;;
    check)
        (( $# == 0 )) || fail "Usage: deploy/check"
        check
        ;;
    down)
        (( $# == 0 )) || fail "Usage: deploy/down"
        "${stack[@]}" down
        ;;
    backup)
        (( $# == 1 )) || fail "Usage: deploy/backup /path/to/backup.tar"
        backup "$1"
        ;;
    restore)
        (( $# == 1 )) || fail "Usage: deploy/restore /path/to/backup.tar"
        [[ -f $1 && -f $1.sha256 ]] || fail "Provide the trusted archive and its .sha256 file"
        digest=$(sha256sum "$1" | cut -d ' ' -f 1)
        [[ $digest == "$(<"$1.sha256")" ]] || fail "Backup SHA-256 mismatch"
        if docker volume inspect "${project}_rdf-data" >/dev/null 2>&1; then
            fail "Restore requires a fresh Compose project with no RDF volume"
        fi
        build_images
        "${stack[@]}" run --rm --no-deps -T --entrypoint tar api \
            -xpf - -C "$rdf_root" < "$1"
        [[ $(selection) == "$RDF_MANIFEST_SHA256" ]] || fail "Restored volume does not select the expected fixture"
        start
        check
        ;;
    *) fail "Use deploy/configure, up, check, down, backup or restore" ;;
esac
